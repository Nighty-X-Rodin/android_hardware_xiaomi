cc_binary {
    name: "android.hardware.vibrator-service.xiaomi",
    vendor: true,
    cflags: [
        "-Wall",
        "-Werror",
    ],
    relative_install_path: "hw",
    init_rc: ["android.hardware.vibrator-service.xiaomi.rc"],
    vintf_fragments: ["android.hardware.vibrator-service.xiaomi.xml"],
    srcs: [
        "service.cpp",
        "Vibrator.cpp",
        "VibratorOffload.cpp",
        "effect.cpp",
        "VibratorPatterns.cpp",
    ],
    shared_libs: [
        "libcutils",
        "libutils",
        "liblog",
        "libbase",
        "libbinder_ndk",
        "android.hardware.vibrator-V2-ndk",
    ],
    local_include_dirs: [
        ".",
        "include",
    ],
}
